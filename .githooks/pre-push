#!/usr/bin/env bash
# EL PORTERO del repo Android. Gemelo del de U-Windows-App (.githooks/pre-push), reescrito para
# Gradle: mismas cuatro comprobaciones, mismo espíritu — lo que TIENE que pasar va aquí; los .md
# explican el porqué. Se activa con UNA línea:
#     git config core.hooksPath .githooks
#
# Tarda ~1-2 min con el daemon de Gradle caliente. Si algún día tarda más, se recorta el hook,
# no la paciencia: un portero que cansa es un portero que alguien acaba saltándose con --no-verify.

set -u

rojo()  { printf '\033[31m%s\033[0m\n' "$*"; }
verde() { printf '\033[32m%s\033[0m\n' "$*"; }
gris()  { printf '\033[90m%s\033[0m\n' "$*"; }

raiz="$(git rev-parse --show-toplevel)"
cd "$raiz" || exit 1

# El SDK: la variable si existe; si no, local.properties; si no, el default de Android Studio.
if [ -z "${ANDROID_HOME:-}" ]; then
  if [ -f local.properties ]; then
    ANDROID_HOME="$(sed -n 's/^sdk.dir=//p' local.properties | head -1)"
  fi
  [ -n "${ANDROID_HOME:-}" ] || ANDROID_HOME="$HOME/Android/Sdk"
  export ANDROID_HOME
fi

rama="$(git rev-parse --abbrev-ref HEAD)"
fallos=0
log="${TMPDIR:-/tmp}/android-portero-build.log"

echo
echo "  ── el portero ──────────────────────────────────"
echo

# ── 0. a main no se empuja directo ───────────────────────────────────────────────────────────
if [ "$rama" = "main" ]; then
  rojo "  ✘  a main no se empuja directo"
  echo "     Haz tu rama, empújala, y abre el PR:"
  echo "         git switch -c <persona>/<que-hace>"
  echo
  exit 1
fi

# ── 1. compila ───────────────────────────────────────────────────────────────────────────────
# Se juzga lo que se distribuye: el build type release, no el debug.
gris "  … compilando (release)"
if ./gradlew :app:compileReleaseKotlin -q > "$log" 2>&1; then
  verde "  ✔  compila"
else
  rojo  "  ✘  NO compila"
  grep -E "^e: |error:" "$log" | head -5 | sed 's/^/     /'
  fallos=$((fallos+1))
fi

# ── 2. el contrato ───────────────────────────────────────────────────────────────────────────
# No son «tests» genéricos: son las promesas que el sistema dice cumplir. Rojo aquí significa que
# algo que prometíamos dejó de ser cierto, y eso no entra en main aunque compile.
if [ -f scripts/contrato.sh ]; then
  gris "  … el contrato"
  salida="$(bash scripts/contrato.sh 2>&1)"
  if printf '%s' "$salida" | grep -q "CONTRATO INTACTO"; then
    verde "  ✔  contrato intacto"
  else
    rojo  "  ✘  CONTRATO ROTO"
    printf '%s' "$salida" | grep -E "✘|⧗|ROTO|incumplid" | head -5 | sed 's/^/     /'
    fallos=$((fallos+1))
  fi
else
  gris "  ·  contrato: no está scripts/contrato.sh, se salta"
fi

# ── 3. la funcionalidad trae su propio test ──────────────────────────────────────────────────
# Es la promesa que hace crecer la carpeta de contrato SOLA, en vez de por disciplina.
# Se exime lo que por definición no añade comportamiento: chore/, docs/, refactor/ y hotfix/.
case "$rama" in
  chore/*|docs/*|refactor/*|hotfix/*)
    gris "  ·  test propio: no se exige en «${rama%%/*}/»"
    ;;
  *)
    base="$(git merge-base HEAD origin/main 2>/dev/null || echo main)"
    tocado_codigo="$(git diff --name-only "$base"...HEAD -- 'core/src/commonMain/**/*.kt' 'app/src/main/**/*.kt' | wc -l)"
    tocado_test="$(git diff --name-only "$base"...HEAD -- 'core/src/commonTest/**' 'app/src/test/**' | wc -l)"
    if [ "$tocado_codigo" -gt 0 ] && [ "$tocado_test" -eq 0 ]; then
      rojo "  ✘  esta rama cambia código y no añade ninguna promesa"
      echo "     $tocado_codigo archivo(s) de código, 0 de contrato."
      echo "     Añade lo que esta funcionalidad promete en core/src/commonTest/kotlin/graph/core/contrato/"
      echo "     —o renómbrala a chore/ o refactor/ si de verdad no cambia comportamiento."
      fallos=$((fallos+1))
    else
      verde "  ✔  trae su propio test"
    fi
    ;;
esac

echo
if [ "$fallos" -gt 0 ]; then
  rojo "  no entra: $fallos comprobación(es) en rojo"
  echo
  gris "  Si crees que el portero se equivoca, la conversación es sobre la promesa,"
  gris "  no sobre saltarse el hook."
  echo
  exit 1
fi

verde "  todo en verde — adelante"
echo
exit 0
